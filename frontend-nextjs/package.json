{
  "name": "frontend-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "description": "Next.js shell for Penpot. Strangler Fig migration of frontend/ (ClojureScript). Talks to the existing Clojure backend over Transit RPC; the backend is NOT modified until the migrated pages reach parity.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "next dev -p 3450",
    "build": "next build",
    "start": "next start -p 3450",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "translations": "node scripts/extract-translations.mjs"
  },
  "dependencies": {
    "@penpot/api-types": "workspace:*",
    "@penpot/draft-js": "link:../frontend/packages/draft-js",
    "@penpot/mousetrap": "link:../frontend/packages/mousetrap",
    "@penpot/plugins-runtime": "link:../plugins/libs/plugins-runtime",
    "@penpot/svgo": "penpot/svgo#3.3.0",
    "@penpot/text-editor": "link:../frontend/text-editor",
    "@penpot/tokenscript": "link:../frontend/packages/tokenscript",
    "@penpot/ua-parser": "penpot/ua-parser#1.0.0",
    "@tokens-studio/sd-transforms": "2.0.3",
    "@tokens-studio/tokenscript-interpreter": "^0.26.0",
    "date-fns": "^4.4.0",
    "draft-js": "penpot/draft-js.git#c58ebd9429a6359d72a88cff87e078aaf6fe285d",
    "eventsource-parser": "^4.1.1",
    "immutable": "3.8.3",
    "js-beautify": "^2.0.3",
    "lodash": "^4.18.1",
    "next": "^15.5.0",
    "opentype.js": "^2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "rxjs": "8.0.0-alpha.14",
    "sax": "^1.6.1",
    "style-dictionary": "5.5.5",
    "tdigest": "^0.1.3",
    "tinycolor2": "^1.6.0",
    "transit-js": "^0.8.874"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
