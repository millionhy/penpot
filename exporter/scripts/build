#!/usr/bin/env bash

set -ex

export CURRENT_VERSION=$1;
export NODE_ENV=production;

pnpm install || exit 1;
pnpm run build:wasm;

WASM_SRC="resources/wasm";
WASM_SHARED="$WASM_SRC/shared.js";
if [ ! -f "$WASM_SRC/render-wasm.wasm" ] || [ ! -f "$WASM_SHARED" ]; then
    echo "ERROR: the render-wasm build did not produce:" >&2;
    echo "  $WASM_SRC/render-wasm.wasm" >&2;
    echo "  $WASM_SHARED" >&2;
    exit 1;
fi

# Build the application; the script clears target and copies the wasm
# artifacts, package files and setup script into it.
node esbuild.config.mjs "$CURRENT_VERSION";
